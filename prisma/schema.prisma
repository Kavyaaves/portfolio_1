// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Syllabus {
  id       Int    @id @default(autoincrement())
  name     String
  category String

}

model Notes {
  id   Int    @id @default(autoincrement())
  name String
}

model Iyengar {
  id   Int    @id @default(autoincrement())
  name String
  path String
}

model Marine {
  id           Int    @id @default(autoincrement())
  name         String
  title        String
  desc         String
  para1        String
  para2        String
  division     String
  class        String
  order        String
  family       String
  basionym     String
  synonym      String @default("")
  ecology      String @default("")
  distribution String @default("")
  img1Caption  String
  imgCaption   String @default("")
}

model Freshwater {
  id           Int    @id @default(autoincrement())
  name         String
  title        String
  desc         String
  para1        String
  para2        String
  division     String
  class        String
  order        String
  family       String
  basionym     String
  synonym      String @default("")
  ecology      String @default("")
  distribution String @default("")
  img1Caption  String
  imgCaption   String @default("")
}
